extends layout

block content

  .header-image
    img(src='https://i.pinimg.com/736x/d7/01/6d/d7016d978d440748a46332942335a6ed.jpg' alt='Fat Unicorn')

  h1= title
  p Welcome to #{title}
  ol
  each val in todos
    li
      span.task-name= val.task + ' - '

      if val.completed
        span.completed Completed
      else
        span.pending Not Completed

      .task-actions
        form(method='POST' action='/complete')
          input(type='hidden', name='id', value=val.id)
          button(type='submit') Complete

        button.edit-btn(type='button') Edit

        form.edit-form(method='POST' action='/edit' style='display:none')
          input(type='hidden', name='id', value=val.id)
          input(type='text', name='task', value=val.task, required)
          button(type='submit') Save
          button.cancel-btn(type='button') Cancel

        form(method='POST' action='/delete')
          input(type='hidden', name='id', value=val.id)
          button(type='submit') Delete

  script(src='/javascripts/edit.js')

  hr
  h2 Add a new task

  if error
    p.error-message Please enter a task before submitting!
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required)
    button(type='submit') Create Task
